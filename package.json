{
  "name": "mutuals-landing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:4000": "NODE_ENV=development WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --port 4000",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run test:render",
    "test:unit": "vitest run --exclude tests/db.integration.test.ts --exclude tests/product-v1.acceptance.integration.test.ts --exclude tests/e2e/**",
    "test:db": "npm run db:test:prepare && DATABASE_URL=postgresql://127.0.0.1:55432/mewtuals_test vitest run tests/db.integration.test.ts tests/product-v1.acceptance.integration.test.ts",
    "test:acceptance": "npm run db:test:prepare && DATABASE_URL=postgresql://127.0.0.1:55432/mewtuals_test vitest run tests/product-v1.acceptance.integration.test.ts",
    "test:e2e": "playwright test tests/e2e/product-v1.spec.ts",
    "test:watch": "vitest",
    "test:render": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .worktrees",
    "db:start": "node scripts/local-postgres.mjs start",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:status": "node scripts/local-postgres.mjs status",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.mjs",
    "db:seed": "tsx scripts/db-seed.mjs",
    "db:test:prepare": "npm run db:start && DATABASE_URL=postgresql://127.0.0.1:55432/mewtuals_test npm run db:migrate && DATABASE_URL=postgresql://127.0.0.1:55432/mewtuals_test npm run db:seed",
    "db:setup": "npm run db:setup:local",
    "db:setup:local": "npm run db:start && DATABASE_URL=postgresql://127.0.0.1:55432/mewtuals npm run db:migrate && DATABASE_URL=postgresql://127.0.0.1:55432/mewtuals npm run db:seed"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
